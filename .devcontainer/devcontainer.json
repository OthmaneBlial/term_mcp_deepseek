{
  "name": "Term MCP DeepSeek contributor",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm@sha256:7876580dc67fd460fd962f004cbeb480027e9bbc0657096f1087db11f9eaff39",
  "remoteUser": "vscode",
  "containerEnv": {
    "APPROVAL_MODE": "inspect",
    "ALLOW_NETWORK": "false",
    "WORKSPACE_ROOT": "${containerWorkspaceFolder}"
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install --editable '.[dev]'",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  }
}
