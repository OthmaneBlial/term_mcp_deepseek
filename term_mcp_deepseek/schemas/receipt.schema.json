{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OthmaneBlial/term_mcp_deepseek/schemas/receipt-1.0.json",
  "title": "Term MCP DeepSeek execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "plan_id",
    "session_id",
    "command",
    "command_sha256",
    "cwd",
    "mode",
    "risk",
    "approved",
    "policy",
    "status",
    "started_at",
    "finished_at",
    "duration_ms",
    "exit_code",
    "signal",
    "stdout",
    "stderr",
    "output_truncated",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "command": {"type": "string"},
    "command_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cwd": {"type": "string"},
    "mode": {"enum": ["inspect", "confirm", "trusted"]},
    "risk": {"enum": ["low", "medium", "high", "blocked"]},
    "approved": {"type": "boolean"},
    "policy": {
      "type": "object",
      "required": ["allowed", "risk", "requires_approval", "reasons", "argv"],
      "properties": {
        "allowed": {"type": "boolean"},
        "risk": {"enum": ["low", "medium", "high", "blocked"]},
        "requires_approval": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "argv": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["succeeded", "failed", "cancelled", "timed_out"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "exit_code": {"type": ["integer", "null"]},
    "signal": {"type": ["integer", "null"], "minimum": 1},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"},
    "output_truncated": {"type": "boolean"},
    "sharing_redacted": {"type": "boolean"},
    "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
